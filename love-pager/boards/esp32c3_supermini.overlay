#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/pinctrl/esp32c3-pinctrl.h>

/ {
    chosen {
	zephyr,display = &oled;
    };

    zephyr,user {
        vibro-gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
        button-gpios = <&gpio0 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
    };
};

&pinctrl {
    i2c0_oled: i2c0_oled {
        group1 {
            pinmux = <I2C0_SDA_GPIO5>,
                     <I2C0_SCL_GPIO6>;

            bias-pull-up;
            drive-open-drain;
            output-high;
        };
    };
};

&i2c0 {
    status = "okay";
    clock-frequency = <I2C_BITRATE_STANDARD>;

    pinctrl-0 = <&i2c0_oled>;
    pinctrl-names = "default";

    #address-cells = <1>;
    #size-cells = <0>;

    oled: ssd1306@3c {
        compatible = "solomon,ssd1306";
        reg = <0x3c>;

        width = <72>;
        height = <40>;

        segment-offset = <28>;
        page-offset = <0>;
        display-offset = <0>;

        multiplex-ratio = <39>;

        segment-remap;
        com-invdir;

        prechargep = <0x22>;

        use-internal-iref;

        status = "okay";
    };
};
